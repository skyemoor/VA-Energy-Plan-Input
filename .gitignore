# Large public source data -- re-downloadable, not stored here.
# See docs/DATA_SOURCES.md for provenance and retrieval.
*.csv
!registers/*.csv
!results/hourly_dispatch/*.csv
insolation_data/
# Derived intermediates -- rebuildable by run_all.py, not committed
data/intermediates/
# Run manifests are OUTPUTS, one per stage per run. Committing them meant every user's own run
# overwrote tracked files, turning a normal `git pull` into a merge conflict (reported 2026-09-10).
# They are regenerated by run_all.py and belong to whoever ran it, not to the repository.
results/manifests/
# Large public source data -- see docs/DATA_SOURCES.md
data/source/
__pycache__/
*.pyc
.pytest_cache/
# Credentials -- never commit
.ghtoken
*.token
